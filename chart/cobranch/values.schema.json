{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cobranch's chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "The image's repository, without a tag."
        },
        "tag": {
          "type": "string",
          "description": "Empty means the chart's appVersion."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      }
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cobranch": {
          "$ref": "#/definitions/image"
        },
        "console": {
          "$ref": "#/definitions/image"
        },
        "backOffice": {
          "$ref": "#/definitions/image"
        }
      },
      "required": [
        "cobranch",
        "console",
        "backOffice"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Console's public URL: a host, and a path the route strips if any. Such as https://cobranch.example.com."
        },
        "rest": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The REST API's public URL, under which it answers /v1/: a host, and a path the route strips if any. Such as https://api.cobranch.example.com or https://cobranch.example.com/api."
        },
        "graphql": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The GraphQL API's public URL: a host, and a path the route strips if any. Such as https://graphql.cobranch.example.com or https://cobranch.example.com/graphql."
        },
        "auth": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Auth server's public URL, which signs people in: a host, and a path the route strips if any. Each identity provider's redirect URI is it plus /callback. Such as https://auth.cobranch.example.com or https://cobranch.example.com/auth."
        },
        "admin": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Admin server's public URL, under which it answers /v1/ to the Back-office: a host, and a path the route strips if any. With it, the chart runs the Admin server and the Back-office, which urls.backOffice must name. Such as https://admin.cobranch.example.com/api."
        },
        "backOffice": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Back-office's public URL, where an installation's administrators run it: a host, and a path the route strips if any. Such as https://admin.cobranch.example.com."
        },
        "git": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Git server's public URL, where Git clients clone, fetch and push over HTTPS: a host, and a path the route strips if any. With it, the chart runs the Git server and the push worker. Such as https://git.cobranch.example.com or https://cobranch.example.com/git."
        },
        "gitSsh": {
          "type": "string",
          "pattern": "^$|^ssh://[A-Za-z0-9._-]+@[A-Za-z0-9.-]+(:[0-9]+)?$",
          "description": "The Git server's SSH address, where Git clients clone, fetch and push with an SSH key: a user, a host and a port if not 22, without a path. With it and git, the Git server also serves SSH. Such as ssh://git@git.cobranch.example.com or ssh://git@cobranch.example.com:2222."
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(s3|gs|azblob|file)://.+",
          "description": "The bucket's Go Cloud URL: s3://, gs://, azblob:// or file://."
        },
        "envFromSecret": {
          "type": "string"
        },
        "volume": {
          "type": "object"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "url"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^(https?://.+)?$"
            },
            "headersSecret": {
              "type": "string"
            },
            "headersKey": {
              "type": "string",
              "minLength": 1
            },
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^OTEL_[A-Z0-9_]+$",
            "not": {
              "enum": [
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_EXPORTER_OTLP_HEADERS",
                "OTEL_SERVICE_NAME",
                "OTEL_TRACES_SAMPLER",
                "OTEL_TRACES_SAMPLER_ARG"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "authServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "restServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "graphqlServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "adminServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "gitServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "cache",
        "maxPushSize",
        "storage",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)?$",
              "description": "How much of the bucket's packs a pod keeps, such as 10Gi."
            }
          }
        },
        "maxPushSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)?$",
          "description": "The largest pack a push may send, such as 2Gi."
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeLimit"
          ],
          "properties": {
            "sizeLimit": {
              "type": "string",
              "minLength": 1,
              "description": "The pod's emptyDir, which holds the cache and the requests in flight, as a Kubernetes quantity: above cache.size by a few maxPushSize."
            }
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "hostKey"
          ],
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "port"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ],
                  "description": "The SSH Service's type: ClusterIP for a route of the operator's, LoadBalancer to reach it directly."
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "The SSH Service's port, which urls.gitSsh names unless it is 22."
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "hostKey": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "secretKey"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "A Secret of the operator's that holds the SSH host key, a private key in PEM; empty, the chart generates one and keeps it."
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key of the Secret's entry that holds the host key."
                }
              }
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "pushWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDeadlineSeconds",
        "resources"
      ],
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule",
        "activeDeadlineSeconds",
        "compaction",
        "storage",
        "resources"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 9,
          "description": "A cron schedule; hourly by default."
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "How long a run may take, in seconds, after which it fails."
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 2,
              "description": "With urls.git, compacts the packs of every repository that has this many into one; null leaves packs alone."
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeLimit"
          ],
          "properties": {
            "sizeLimit": {
              "type": "string",
              "minLength": 1,
              "description": "The pod's emptyDir while it compacts, as a Kubernetes quantity: above twice the largest repository's packs."
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "description": "Demo data for a demo installation, such as Cobranch's own pull request previews: never turn it on for a real one.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "The migrate Job adds Cobranch's demo data (db/seeds) after migrating the schema."
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "backOffice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "The image's repository, without a tag."
            },
            "tag": {
              "type": "string",
              "description": "The image's tag."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array"
        }
      }
    },
    "global": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sign-in: the identity providers and the policies.",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clientId",
              "clientSecret"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                "description": "Names the provider in URLs and the database: lowercase letters, digits and dashes. Keep it."
              },
              "name": {
                "type": "string",
                "description": "What the sign-in page shows; the id when empty."
              },
              "issuer": {
                "type": "string",
                "pattern": "^(https://.+)?$",
                "description": "The provider's issuer URL, whose /.well-known/openid-configuration says the rest."
              },
              "preset": {
                "type": "string",
                "enum": [
                  "google"
                ],
                "description": "A known provider, which fills the issuer in."
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "clientSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "secretName"
                ],
                "properties": {
                  "secretName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A Secret of yours that holds the client's secret."
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Its key; client-secret by default."
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "issuer"
                ],
                "properties": {
                  "issuer": {
                    "minLength": 1
                  }
                },
                "not": {
                  "required": [
                    "preset"
                  ]
                }
              },
              {
                "required": [
                  "preset"
                ]
              }
            ]
          }
        },
        "signUp": {
          "type": "string",
          "enum": [
            "",
            "anyone",
            "domains",
            "invited"
          ],
          "description": "Who may sign up; empty, the Back-office's setting."
        },
        "signUpDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "secretsKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "organizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selfServe": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Every new user may create organizations; null, the Back-office's setting."
        }
      }
    }
  },
  "required": [
    "blob",
    "authServer",
