{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cobranch's chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "The image's repository, without a tag."
        },
        "tag": {
          "type": "string",
          "description": "Empty means the chart's appVersion."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      }
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cobranch": {
          "$ref": "#/definitions/image"
        },
        "console": {
          "$ref": "#/definitions/image"
        }
      },
      "required": [
        "cobranch",
        "console"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Console's public URL: a host, and a path the route strips if any. Such as https://cobranch.example.com."
        },
        "rest": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The REST API's public URL, under which it answers /v1/: a host, and a path the route strips if any. Such as https://api.cobranch.example.com or https://cobranch.example.com/api."
        },
        "graphql": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The GraphQL API's public URL: a host, and a path the route strips if any. Such as https://graphql.cobranch.example.com or https://cobranch.example.com/graphql."
        },
        "auth": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*/?$",
          "description": "The Auth server's public URL, which signs people in: a host, and a path the route strips if any. Each identity provider's redirect URI is it plus /callback. Such as https://auth.cobranch.example.com or https://cobranch.example.com/auth."
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(s3|gs|azblob|file)://.+",
          "description": "The bucket's Go Cloud URL: s3://, gs://, azblob:// or file://."
        },
        "envFromSecret": {
          "type": "string"
        },
        "volume": {
          "type": "object"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "url"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^(https?://.+)?$"
            },
            "headersSecret": {
              "type": "string"
            },
            "headersKey": {
              "type": "string",
              "minLength": 1
            },
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^OTEL_[A-Z0-9_]+$",
            "not": {
              "enum": [
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_EXPORTER_OTLP_HEADERS",
                "OTEL_SERVICE_NAME",
                "OTEL_TRACES_SAMPLER",
                "OTEL_TRACES_SAMPLER_ARG"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "authServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "restServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "graphqlServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDeadlineSeconds",
        "resources"
      ],
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule",
        "resources"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 9,
          "description": "A cron schedule; hourly by default."
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "description": "Demo data for a demo installation, such as Cobranch's own pull request previews: never turn it on for a real one.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "The migrate Job adds Cobranch's demo data (db/seeds) after migrating the schema."
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "The image's repository, without a tag."
            },
            "tag": {
              "type": "string",
              "description": "The image's tag."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array"
        }
      }
    },
    "global": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sign-in: the identity providers and the policies.",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clientId",
              "clientSecret"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                "description": "Names the provider in URLs and the database: lowercase letters, digits and dashes. Keep it."
              },
              "name": {
                "type": "string",
                "description": "What the sign-in page shows; the id when empty."
              },
              "issuer": {
                "type": "string",
                "pattern": "^(https://.+)?$",
                "description": "The provider's issuer URL, whose /.well-known/openid-configuration says the rest."
              },
              "preset": {
                "type": "string",
                "enum": [
                  "google"
                ],
                "description": "A known provider, which fills the issuer in."
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "clientSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "secretName"
                ],
                "properties": {
                  "secretName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A Secret of yours that holds the client's secret."
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Its key; client-secret by default."
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "issuer"
                ],
                "properties": {
                  "issuer": {
                    "minLength": 1
                  }
                },
                "not": {
                  "required": [
                    "preset"
                  ]
                }
              },
              {
                "required": [
                  "preset"
                ]
              }
            ]
          }
        },
        "signUp": {
          "type": "string",
          "enum": [
            "anyone",
            "domains",
            "invited"
          ]
        },
        "signUpDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "organizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selfServe": {
          "type": "boolean",
          "description": "Every new user may create organizations."
        }
      }
    }
  },
  "required": [
    "blob",
    "authServer",
    "restServer",
    "graphqlServer",
    "console",
    "migrate",
    "maintenance"
  ]
}
