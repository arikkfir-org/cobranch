# Cobranch's GraphQL schema, written first: internal/adapters/graphql generates its resolvers' types from it. It is the
# Console's surface (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/architecture.md, "API conventions").

"An instant, as RFC 3339."
scalar Time

type Query {
  "The version of Cobranch that serves this installation: a release version or a commit's short SHA."
  version: String!
  "Who the request's credential signs in, or null for Anonymous."
  viewer: User
}

type Mutation {
  "Revokes one of the viewer's sessions; the next request with its cookie fails. False when the viewer has no such session."
  revokeSession(id: ID!): Boolean!
  "Makes a personal token that acts as the viewer, narrowed to the permissions it lists, and shows it once; only from a session, never from another token or an API key."
  createPersonalToken(input: PersonalTokenInput!): PersonalTokenCreated!
  "Revokes one of the viewer's personal tokens; the next request with it fails. False when the viewer has no such token."
  revokePersonalToken(id: ID!): Boolean!
  "Adds an SSH key that acts as the viewer over SSH, as their session would; only from a session, never from a token or an API key."
  addSSHKey(input: SSHKeyInput!): SSHKey!
  "Deletes one of the viewer's SSH keys; the next connection with it fails; only from a session, never from a token or an API key. False when the viewer has no such key."
  deleteSSHKey(id: ID!): Boolean!
}

"A person: a principal of kind user."
type User {
  id: ID!
  displayName: String!
  "The emails the user holds; the sign-up's verified one today, several later."
  emails: [Email!]!
  "The user's live sessions, newest first."
  sessions: [Session!]!
  "The user's personal tokens that are not revoked, expired ones included, newest first."
  personalTokens: [PersonalToken!]!
  "The user's SSH keys, newest first."
  sshKeys: [SSHKey!]!
}

type Email {
  email: String!
  verified: Boolean!
}

"A signed-in browser."
type Session {
  id: ID!
  createdAt: Time!
  lastSeenAt: Time!
  "When the session ends however it is used."
  expiresAt: Time!
  userAgent: String!
  ip: String!
  "Whether this is the session the request itself came with."
  current: Boolean!
}

"A personal token, as its user sees it; the token itself was shown once."
type PersonalToken {
  id: ID!
  name: String!
  "The token's last four characters."
  hint: String!
  "The permissions the token may use, sorted; a check under it holds only what both these and the user's grants give."
  permissions: [String!]!
  createdAt: Time!
  "When the token stops working."
  expiresAt: Time!
  lastUsedAt: Time
}

"What makes a personal token."
input PersonalTokenInput {
  "What the token is for, 1 to 100 characters."
  name: String!
  "The permissions the token may use, from the catalog; repo.read and repo.push when null or empty."
  permissions: [String!]
  "When the token stops working, in the future and within a year; 30 days from now when null."
  expiresAt: Time
}

"A personal token and its secret, which is shown here and never again."
type PersonalTokenCreated {
  token: PersonalToken!
  "The token, to give a Git client as its password or a script as its bearer token."
  secret: String!
}

"An SSH key, as its user sees it."
type SSHKey {
  id: ID!
  name: String!
  "The key's type and base64, as an authorized_keys line has them, without its comment."
  publicKey: String!
  "The key's SHA256 fingerprint, as ssh-keygen -l shows it."
  fingerprint: String!
  createdAt: Time!
  lastUsedAt: Time
}

"What adds an SSH key."
input SSHKeyInput {
  "What the key is for, 1 to 100 characters; the key's comment when null or empty."
  name: String
  "One public key as an authorized_keys line has it, such as ssh-ed25519 AAAA… you@laptop, with no options; Ed25519, ECDSA, or RSA of 2048 bits or more."
  publicKey: String!
}

"The scopes roles are granted at. Repositories come with their slice."
enum RoleScope {
  ORGANIZATION
}

extend type Query {
  "An organization by its slug, current or former: null unless the viewer may read it."
  organization(slug: String!): Organization
  "The permissions a role granted at a scope may hold, from the catalog."
  permissions(scope: RoleScope!): [String!]!
  "The built-in roles granted at a scope."
  roles(scope: RoleScope!): [Role!]! @deprecated(reason: "Roles are an organization's: Organization.roles lists them all. Removed two minor releases after 0.2.")
}

extend type User {
  "The permissions the viewer holds at the installation, such as orgs.create."
  permissions: [String!]!
  "The organizations the viewer belongs to."
  organizations: [Organization!]!
  "The pending invitations to the viewer's verified emails."
  invitations: [Invitation!]!
  "The viewer's pending requests to join organizations."
  joinRequests: [JoinRequest!]!
}

extend type Mutation {
  "Creates an organization and makes the viewer its Owner; takes orgs.create."
  createOrganization(slug: String!, name: String!): Organization!
  "Changes an organization's settings; takes org.manage. A new slug keeps the old one as an alias."
  updateOrganization(id: ID!, input: OrganizationSettings!): Organization!
  "Invites an email to the organization with a role; takes org.members.manage and the role's permissions."
  inviteMember(organizationId: ID!, email: String!, roleId: ID!): Invitation!
  "Cancels a pending invitation; takes org.members.manage."
  cancelInvitation(organizationId: ID!, id: ID!): Boolean!
  "Accepts an invitation to one of the viewer's verified emails, and joins the organization."
  acceptInvitation(id: ID!): Organization!
  "Declines an invitation to one of the viewer's verified emails."
  declineInvitation(id: ID!): Boolean!
  "Asks to join an organization that accepts join requests, by slug, with a note for its managers."
  requestToJoin(slug: String!, note: String): JoinRequest!
  "Approves a pending join request with a role; takes org.members.manage and the role's permissions."
  approveJoinRequest(organizationId: ID!, id: ID!, roleId: ID!): Boolean!
  "Declines a pending join request; takes org.members.manage."
  declineJoinRequest(organizationId: ID!, id: ID!): Boolean!
  "Leaves an organization. Its last Owner can't."
  leaveOrganization(id: ID!): Boolean!
  "Removes a member; takes org.members.manage and every permission of the roles they hold. Oneself is leaving."
  removeMember(organizationId: ID!, userId: ID!): Boolean!
  "Gives a member a role; takes org.grants.manage and every permission of the role."
  grantRole(organizationId: ID!, userId: ID!, roleId: ID!): Boolean!
  "Takes a role from a member; takes org.grants.manage and every permission of the role. The last Owner keeps Owner."
  revokeRole(organizationId: ID!, userId: ID!, roleId: ID!): Boolean!
  "Defines a custom role; takes org.grants.manage and every permission it lists."
  createRole(organizationId: ID!, input: RoleInput!): Role!
  "Redefines a custom role, and with it every grant of it; takes org.grants.manage and every permission it listed or lists."
  updateRole(organizationId: ID!, id: ID!, input: RoleInput!): Role!
  "Deletes a custom role nobody holds, cancelling the invitations that offered it; takes org.grants.manage and every permission of the role."
  deleteRole(organizationId: ID!, id: ID!): Boolean!
  "Makes an API key holding roles at the organization, and shows its first secret once; takes org.principals.manage, and the roles add the grant rules."
  createApiKey(organizationId: ID!, input: ApiKeyInput!): ApiKeyCreated!
  "Gives the key a new secret, shown once, beside the old one, which works until revoked or expired; a key with two live secrets takes no third. Takes org.principals.manage."
  rotateApiKey(organizationId: ID!, id: ID!, input: SecretInput): ApiKeyCreated!
  "Revokes one of the key's secrets; a key with no live secret fails every call until rotated. Takes org.principals.manage."
  revokeApiKeySecret(organizationId: ID!, id: ID!, secretId: ID!): Boolean!
  "Deletes an API key with its secrets and grants; takes org.principals.manage and every permission of the roles it holds."
  deleteApiKey(organizationId: ID!, id: ID!): Boolean!
}

"An organization: a slug for its URLs, a name, and its settings."
type Organization {
  id: ID!
  slug: String!
  name: String!
  "The role everyone who joins gets: Member by default."
  membershipRoleId: ID!
  "Whether users may ask to join by slug. Off, the organization answers like one that doesn't exist."
  acceptsJoinRequests: Boolean!
  "The identity providers its members may sign in with, or null for all of the installation's."
  providers: [String!]
  createdAt: Time!
  "The permissions the viewer holds here."
  viewerPermissions: [String!]!
  "The members and the roles they hold; takes org.read."
  members: [Member!]!
  "The pending invitations; takes org.members.manage."
  invitations: [Invitation!]!
  "The pending join requests; takes org.members.manage."
  joinRequests: [JoinRequest!]!
  "The roles the organization grants: the built-in ones first, then its own; takes org.read."
  roles: [Role!]!
  "The API keys, with their roles and secrets, by name; takes org.read."
  apiKeys: [ApiKey!]!
}

"An API key: a principal of the organization that a script acts as, with the roles it holds there and its secrets."
type ApiKey {
  id: ID!
  organizationId: ID!
  name: String!
  "Who made the key; null once they are gone."
  createdBy: ID
  createdAt: Time!
  roles: [Role!]!
  "The key's secrets, oldest first, revoked and expired ones included."
  secrets: [ApiKeySecret!]!
}

"One of an API key's secrets, as its manager sees it; the secret itself was shown once."
type ApiKeySecret {
  id: ID!
  "The secret's last four characters."
  hint: String!
  createdAt: Time!
  "When the secret stops working; null for one that never expires."
  expiresAt: Time
  lastUsedAt: Time
  revokedAt: Time
}

"When a new secret stops working; a year from now when neither is given."
input SecretInput {
  "The end, in the future."
  expiresAt: Time
  "True for a secret with no end; not with expiresAt."
  neverExpires: Boolean
}

"What makes an API key; its first secret's expiry as SecretInput's."
input ApiKeyInput {
  name: String!
  "The roles the key holds at the organization; at least one."
  roleIds: [ID!]!
  expiresAt: Time
  neverExpires: Boolean
}

"A key and a secret of its, which is shown here and never again."
type ApiKeyCreated {
  apiKey: ApiKey!
  "The secret, to put in the script's own secret store."
  secret: String!
}

input OrganizationSettings {
  slug: String!
  name: String!
  membershipRoleId: ID!
  acceptsJoinRequests: Boolean!
  "Null or empty lets members sign in with any of the installation's providers."
  providers: [String!]
}

"A role granted at an organization: built in, or the organization's own."
type Role {
  id: ID!
  name: String!
  description: String!
  permissions: [String!]!
  builtIn: Boolean!
  "The organization a custom role belongs to; null on a built-in role."
  organizationId: ID
}

"A custom role's definition."
input RoleInput {
  name: String!
  description: String
  "From the permissions listed at scope ORGANIZATION; at least one."
  permissions: [String!]!
}

"A user who belongs to an organization, with the roles they hold there."
type Member {
  userId: ID!
  displayName: String!
  joinedAt: Time!
  roles: [Role!]!
}

"An invitation to an email; only a user who holds it, verified, accepts it."
type Invitation {
  id: ID!
  organizationId: ID!
  organizationSlug: String!
  organizationName: String!
  email: String!
  roleId: ID!
  "The role's name; empty once a custom role it offered is gone."
  roleName: String!
  createdAt: Time!
  expiresAt: Time!
}

"A user's request to join an organization, waiting for one of its member managers."
type JoinRequest {
  id: ID!
  organizationId: ID!
  organizationSlug: String!
  organizationName: String!
  userId: ID!
  userName: String!
  note: String!
  createdAt: Time!
  expiresAt: Time!
}
