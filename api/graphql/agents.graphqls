# An organization's agents, principals it owns that its members create and assign tasks to, and their tasks, each of
# which does no more than both its agent and its assigner may
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/agents.md, "Agents" and "Tasks").

extend type Organization {
  "The organization's agents by name, each with its grants; takes org.read."
  agents: [Agent!]!
  "One of the organization's agents by ID: null unless it is there; takes org.read."
  agent(id: ID!): Agent
  "A page of the organization's tasks, newest first, leaving out those on repositories the viewer doesn't read, and those of issues without issues.read: only agent's, those in states and those in repositoryId when they are given, from the newest or from after, where the previous page's nextCursor says the next one starts; takes org.read. first is 1 to 100."
  tasks(agent: ID, states: [TaskState!], repositoryId: ID, first: Int! = 30, after: String): TaskPage!
  "One of the organization's tasks by number: null unless it is there, the viewer reads the repository it names, and, for an issue's task, holds issues.read; takes org.read."
  task(number: Int!): Task
  "The model providers the organization added, by name; takes org.read. The names of their secrets show to a viewer holding secrets.manage at the organization."
  modelProviders: [ModelProvider!]!
  "The model providers the installation knows, by name: those the organization may add."
  availableModelProviders: [String!]!
  "The organization's models, by provider and name, each with what it costs, the most a task on it may spend and the agents on it; takes org.read."
  models: [Model!]!
}

"A model provider an organization added, one the installation knows, with the organization's own secret that holds its API key. An agent on one of its models must read that secret for its tasks to run."
type ModelProvider {
  "The provider's name, as the installation knows it."
  name: String!
  "The organization's secret that holds its API key; null once that secret is deleted."
  secretId: ID
  "That secret's name, shown to a viewer holding secrets.manage at the organization; null otherwise."
  secretName: String
  "Whether it lost its secret, so that the tasks of agents on it can't run until an admin names another."
  broken: Boolean!
  "Who added it; null once they are gone."
  createdBy: CommitPrincipal
  createdAt: Time!
  updatedAt: Time!
  "Counts its changes from 1: a change names it as expectedVersion to refuse one made meanwhile."
  version: Int!
}

"One of an organization's models, of a provider it added, which its agents may run on: what the organization pays per million tokens it reads and writes, from which Cobranch prices each call of it. What a task may spend is its agent's to cap. Amounts are US dollars, as decimals with at most six digits after the point, such as 3.00."
type Model {
  provider: String!
  "The model's name, as its provider gives it."
  name: String!
  "What a million tokens it reads cost, such as 3.00."
  inputPrice: String!
  "What a million tokens it writes cost, such as 15.00."
  outputPrice: String!
  "Whether a new agent starts on it; the organization has at most one."
  default: Boolean!
  "The agents that run on it, by name."
  agents: [CommitPrincipal!]!
  "Who added it; null for one Cobranch added for the agents already on it, and once its adder is gone."
  createdBy: CommitPrincipal
  createdAt: Time!
  updatedAt: Time!
  "Counts its changes from 1: a change names it as expectedVersion to refuse one made meanwhile."
  version: Int!
}

"A secret an agent's tasks receive, in the environment variable name."
type AgentSecret {
  name: String!
  secretId: ID!
}

"One of an organization's agents, a principal it owns that takes tasks, with the roles it holds."
type Agent {
  "Its principal's ID."
  id: ID!
  name: String!
  description: String!
  "The standing instructions, in Markdown, that every task of it starts from."
  instructions: String!
  "Whether Cobranch made it for the organization; it is never deleted."
  builtIn: Boolean!
  "Who created it; null for a built-in agent, and once its creator is gone."
  createdBy: CommitPrincipal
  createdAt: Time!
  updatedAt: Time!
  "Counts its changes from 1: a change names it as expectedVersion to refuse one made meanwhile."
  version: Int!
  "The roles it holds, those at the organization first."
  grants: [AgentGrant!]!
  "The model provider it runs on, one the organization added; null while it runs on none."
  provider: String
  "The model it runs on, as its provider names it; null while it runs on none."
  model: String
  "The most a task of it may spend, in US dollars such as 2.00; null for none."
  cap: String
  "The secrets its tasks receive, by the environment variables they go in."
  secrets: [AgentSecret!]!
}

"A role an agent holds, at its organization or, with a repository, on that repository."
type AgentGrant {
  roleId: ID!
  roleName: String!
  "The repository it holds the role on; null at the organization."
  repositoryId: ID
  repositorySlug: String
}

"Where a task stands. Queued tasks wait for the controller; waiting ones for an answer in their thread."
enum TaskState {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

"A page of an organization's tasks, newest first."
type TaskPage {
  tasks: [Task!]!
  "Where the next page starts, as tasks' after; null after the last page."
  nextCursor: String
}

"A task of one of the organization's agents, which the organization numbers."
type Task {
  id: ID!
  "The organization whose agent it is."
  organizationId: ID!
  "Counts the organization's tasks from 1."
  number: Int!
  agent: CommitPrincipal!
  "What it is for: assigned for a task a principal assigned."
  kind: String!
  "Its assigner, whose permissions cap it; null once they are gone, when it may do nothing."
  assignedBy: CommitPrincipal
  title: String!
  "Its instructions, in Markdown."
  instructions: String!
  "The repository it works in; null for none."
  repositoryId: ID
  repositorySlug: String
  "The branch of that repository it works on; null for none."
  branchId: ID
  branch: String
  "The thread of that branch's chat it talks in; null for none."
  threadId: ID
  "The commit it works at, such as the head a review task reviews; null for none."
  sha: String
  state: TaskState!
  "Why it failed or was cancelled; empty otherwise."
  reason: String!
  "What the agent said it did, once it ended."
  summary: String!
  cancelledBy: CommitPrincipal
  createdAt: Time!
  "When it started; null until it does."
  startedAt: Time
  "When it ended; null until it does."
  endedAt: Time
  "Counts its changes from 1: cancelTask names it as expectedVersion to refuse one made meanwhile."
  version: Int!
  "What it spent so far, at its organization's prices, in US dollars such as 0.42."
  spent: String!
  "The tokens its model read so far."
  inputTokens: Int!
  "The tokens its model wrote so far."
  outputTokens: Int!
  "The most it may spend, its agent's cap, in US dollars; null for none. It fails once it reaches it."
  cap: String
  "Its transcript's entries numbered above after, in order: at most first of them, 1 to 500, 100 unless given. The task's own token reads them, and so do its assigner, a principal holding org.principals.manage, and whoever reads the repository it names; others are refused (FORBIDDEN)."
  transcript(after: Int, first: Int): [TranscriptEntry!]!
}

"The task a task token works, the slug of its organization, which the harness's calls name, its agent's standing instructions, which the task starts from, and email, which its commits carry, and the issue whose chat it talks in."
type MyTask {
  organization: String!
  task: Task!
  "The standing instructions, in Markdown, of the task's agent; empty for none."
  agentInstructions: String!
  "The email of the task's agent, verified, so that the commits that carry it are the agent's."
  agentEmail: String!
  "The number of the issue the task works on, whose chat it talks in; null for none."
  issueNumber: Int
  "The key of the organization's issues, which with issueNumber names the issue the task works on, such as ACME in ACME-42; null for none."
  issueKey: String
}

"What a transcript entry records: INPUT, what the task began with or a message a person sent it since; TURN, a turn of the agent's model with the tool calls it asked for; RESULT, a tool's result; STATE, a change of the task's state."
enum TranscriptEntryKind {
  INPUT
  TURN
  RESULT
  STATE
}

"A step of a task's transcript, numbered from 1 in its task; entries never change."
type TranscriptEntry {
  seq: Int!
  kind: TranscriptEntryKind!
  "What the harness recorded, as it wrote it. A state entry's holds state, and summary or reason."
  body: Map!
  createdAt: Time!
}

"The next entry of a task's transcript. Its body is a JSON object of at most 256 KiB; a state entry's holds state (running, waiting, succeeded or failed), with a summary of 1 to 20000 characters for succeeded and a reason of 1 to 1000 for failed."
input TranscriptEntryInput {
  seq: Int!
  kind: TranscriptEntryKind!
  body: Map!
}

extend type Query {
  "The task the request's task token works, with its organization's slug, for the agent's harness to start from; any other credential is refused (FORBIDDEN)."
  myTask: MyTask!
}

"A role a new agent starts with, at the organization or, with a repository, on that repository."
input AgentGrantInput {
  roleId: ID!
  repositoryId: ID
}

"A new agent."
input AgentInput {
  "1 to 100 characters, unique in the organization in any case."
  name: String!
  "At most 1000 characters."
  description: String
  "At most 20000 characters of Markdown."
  instructions: String
  "At most 20, each one the creator holds every permission of where it applies."
  grants: [AgentGrantInput!]
}

"What changes about an agent; a field left out keeps its value."
input AgentPatch {
  name: String
  description: String
  instructions: String
  "The most a task of it may spend, in US dollars such as 2.00, at most 1000000 (BAD_USER_INPUT, agent.cap_invalid); null for none."
  cap: String
}

"What a model costs and whether it is the default; it replaces what the model had."
input ModelInput {
  "What a million tokens it reads cost, 0 to 10000, such as 3.00."
  inputPrice: String!
  "What a million tokens it writes cost, 0 to 10000, such as 15.00."
  outputPrice: String!
  "Whether a new agent starts on it; null for not."
  default: Boolean
}

"A call of a task's model, as the model proxy of its pod reports it."
input TaskUsageInput {
  "The call's own ID, which a repeated report repeats, so that it counts once."
  id: ID!
  "The model the call asked, as its provider names it."
  model: String!
  "The tokens the model read, 0 to 100000000."
  inputTokens: Int!
  "The tokens the model wrote, 0 to 100000000."
  outputTokens: Int!
}

"What a task spent so far, the most it may spend, and whether it has ended, as it does once it reaches that."
type TaskSpend {
  "In US dollars, at its organization's prices, such as 0.42."
  spent: String!
  inputTokens: Int!
  outputTokens: Int!
  "The most it may spend, in US dollars; null for none."
  cap: String
  "Whether it has ended; its token then acts no more."
  ended: Boolean!
}

"A secret an agent's tasks receive: the environment variable it goes in, other than those the harness sets itself (PATH, HOME and those starting COBRANCH_, GIT_ or LD_), and one of the organization's secrets or its repositories'."
input AgentSecretInput {
  name: String!
  secretId: ID!
}

"A task to assign, and perhaps where it works: a repository, one of its live branches by ID or by name, and a thread of that branch's chat."
input TaskInput {
  agentId: ID!
  "1 to 200 characters."
  title: String!
  "At most 20000 characters of Markdown."
  instructions: String
  repositoryId: ID
  branchId: ID
  "The branch's name, without refs/heads/, when branchId doesn't name it."
  branch: String
  threadId: ID
}

extend type Mutation {
  "Makes an agent of the organization, a principal it owns, with its first grants; takes agents.create, and every permission of each grant where it applies. An agent makes no agents. A name another agent has, in any case, is refused (CONFLICT, agent.name_taken)."
  createAgent(organizationId: ID!, input: AgentInput!): Agent!
  "Changes an agent's name, description, standing instructions or cap; takes being its creator, or org.principals.manage. With expectedVersion, one at another version is refused (CONFLICT, precondition.failed)."
  updateAgent(organizationId: ID!, id: ID!, input: AgentPatch!, expectedVersion: Int): Agent!
  "Deletes an agent with its grants and tasks, and answers true; takes org.principals.manage and every permission of the roles it holds where they apply. A built-in agent is refused (CONFLICT, agent.built_in); with expectedVersion, so is one at another version (CONFLICT, precondition.failed)."
  deleteAgent(organizationId: ID!, id: ID!, expectedVersion: Int): Boolean!
  "Puts an agent on one of the organization's models, or on none with neither given; takes org.principals.manage, and a person. A provider the organization hasn't added is refused (BAD_USER_INPUT, agent.provider_invalid), and so is a model it hasn't (BAD_USER_INPUT, agent.model_invalid); with expectedVersion, so is an agent at another version (CONFLICT, precondition.failed)."
  setAgentModel(organizationId: ID!, id: ID!, provider: String, model: String, expectedVersion: Int): Agent!
  "Names the secrets an agent's tasks receive, at most 50, in place of those it named; takes org.principals.manage, and a person. A task receives only those its agent holds secrets.read on. With expectedVersion, an agent at another version is refused (CONFLICT, precondition.failed)."
  setAgentSecrets(organizationId: ID!, id: ID!, secrets: [AgentSecretInput!]!, expectedVersion: Int): Agent!
  "Adds a provider the installation knows to the organization, with the organization's own secret that holds its API key, or names another secret for the one it has, and answers it; takes org.manage. A provider the installation doesn't know is refused (NOT_FOUND, model_provider.not_found), and a secret that isn't the organization's own (BAD_USER_INPUT, model_provider.secret_invalid). expectedVersion 0 only adds it, and another only changes it at that version (CONFLICT, precondition.failed)."
  setModelProvider(organizationId: ID!, provider: String!, secretId: ID!, expectedVersion: Int): ModelProvider!
  "Removes a provider from the organization, and answers true; takes org.manage. While agents run on it, it is refused (CONFLICT, model_provider.in_use); with expectedVersion, so is one at another version (CONFLICT, precondition.failed)."
  removeModelProvider(organizationId: ID!, provider: String!, expectedVersion: Int): Boolean!
  "Adds a model of a provider the organization added to its models, with what it costs, or changes one of them, and answers it; takes org.manage. Making it the default, which a new agent starts on, makes the one before it no longer so. A provider the organization hasn't added is refused (BAD_USER_INPUT, model.provider_invalid), and a price past 10000 (BAD_USER_INPUT, model.price_invalid). expectedVersion 0 only adds it, and another only changes it at that version (CONFLICT, precondition.failed)."
  setModel(organizationId: ID!, provider: String!, model: String!, input: ModelInput!, expectedVersion: Int): Model!
  "Removes one of the organization's models, and answers true; takes org.manage. While agents run on it, it is refused (CONFLICT, model.in_use); with expectedVersion, so is one at another version (CONFLICT, precondition.failed)."
  removeModel(organizationId: ID!, provider: String!, model: String!, expectedVersion: Int): Boolean!
  "Records a call of the model of the task the request's task token works, as the model proxy of its pod reports it, and answers what the task spent so far; any other credential is refused (FORBIDDEN). Cobranch prices the call at the organization's prices for that model of its agent's provider, or for its agent's model when the organization has none for that one. A report that repeats a call's ID records nothing. The call that brings the task to its cap, its agent's, ends it Failed, saying so, and its token then acts no more; a task that has ended is refused (CONFLICT, task.ended)."
  recordTaskSpend(input: TaskUsageInput!): TaskSpend!
  "Assigns a task to one of the organization's agents, queued until the controller runs it; whatever it does is capped by the assigner's permissions as they are when it acts. Takes agents.assign, and repo.read on the repository it names. An agent assigns no tasks."
  assignTask(organizationId: ID!, input: TaskInput!): Task!
  "Cancels one of the organization's tasks that hasn't ended, and answers it as it now is; takes being its assigner, or org.principals.manage. A task that has ended is refused (CONFLICT, task.ended); with expectedVersion, so is one at another version (CONFLICT, precondition.failed)."
  cancelTask(organizationId: ID!, number: Int!, expectedVersion: Int): Task!
  "Appends the next entry to the transcript of one of the organization's tasks; only the task's own token appends (FORBIDDEN otherwise), while the task hasn't ended (CONFLICT, task.ended). An entry already numbered seq answers unchanged, so a harness that repeats an append records it once; a number past the next is refused (BAD_USER_INPUT, transcript.seq_invalid). A state entry moves the task too: a running task to waiting and back, one that runs or waits to succeeded or failed; another move is refused (CONFLICT, task.transition_invalid)."
  appendTranscriptEntry(organizationId: ID!, number: Int!, input: TranscriptEntryInput!): TranscriptEntry!
}
