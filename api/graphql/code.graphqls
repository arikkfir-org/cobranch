# A repository's code as pushes recorded it: its branches, its history and its commits
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/git-hosting.md, "The Console"); and its tags,
# trees and files, which the Git server reads
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/code-browsing.md, "Trees and files"); and
# the annotations principals set on its commits
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/branch-status.md, "Annotations"); and the
# reviews they submit of them and the diffs they review
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/reviews.md, "Reviews" and "Diffs").

extend type Repository {
  "The repository's live branches, main first and then by name, each with the commit it is at, its status as a request to merge into its base and what a merge into it needs; takes repo.read."
  branches: [Branch!]!
  "One of the repository's live branches by name, without refs/heads/, as branches answers each: null unless it is there; takes repo.read."
  branch(name: String!): Branch
  "A page of history, nearest first: from the branch's head, or from the commit ref names (a full name, a branch or a tag, tried in that order), or from after, where the previous page's nextCursor says the next one starts; takes repo.read. Along FIRST parents, as git log --first-parent lists it, it walks the commits pushes recorded, and a branch at no commit a push recorded has none. Along ALL parents, as git log --date-order lists it (no commit before its children, the newest first among those the graph leaves free), the Git server walks it, leaving out any commit no push recorded; a ref that finds nothing is a NOT_FOUND error whose reason is ref.not_found, and an installation without a Git server answers UNAVAILABLE. first is 1 to 100."
  history(branch: String! = "main", ref: String, parents: HistoryParents! = FIRST, first: Int! = 30, after: String): CommitPage!
  "One of the repository's commits by its full name, in lowercase hexadecimal, with the push that first brought it: null unless the repository holds it; takes repo.read."
  commit(sha: String!): Commit
  "One of the repository's reviews by its ID: null unless the repository holds it; takes repo.read."
  review(id: ID!): Review
  "The repository's tags, by name, each with the object it names; takes repo.read."
  tags: [Tag!]!
  "The directory at path of the commit ref names, its directories and submodules first and then its files and symlinks, each by name, with its README; takes repo.read. ref is a branch's or a tag's name, or a commit's full name, tried in the order full name, branch, tag; path is relative to the root, as names separated by /, and empty for the root. A ref or a path that finds nothing is a NOT_FOUND error, whose reason is ref.not_found, path.not_found, path.file or path.submodule; an installation without a Git server answers UNAVAILABLE."
  tree(ref: String! = "main", path: String! = ""): Tree
  "The file or symlink at path of the commit ref names, as tree takes them: whether it is binary and, when it isn't, its text up to 1 MiB; takes repo.read. Its bytes are at the REST API's raw. A directory's path is a NOT_FOUND error whose reason is path.directory."
  blob(ref: String! = "main", path: String!): File
  "A branch's change as a request to merge into its base: from the merge base of its base's tip and its head to its head, so what its base gained since doesn't show; null unless the branch is there; takes repo.read. Main merges into nothing: a BAD_USER_INPUT error whose reason is branch.default. It reads the Git server: an installation without one answers UNAVAILABLE."
  branchDiff(name: String!): Diff
  "A commit's change against its first parent, or against the empty tree when it has none: null unless the repository holds it; takes repo.read. It reads the Git server: an installation without one answers UNAVAILABLE."
  commitDiff(sha: String!): Diff
}

"One of a repository's tags and the object it names, a commit or an annotated tag."
type Tag {
  "Its name, without refs/tags/."
  name: String!
  "The object it names."
  target: String!
}

"A directory at a commit."
type Tree {
  "The commit the ref resolved to, which every link to the directory's files may pin."
  commit: String!
  "Its path from the repository's root; empty for the root."
  path: String!
  "Its tree's object."
  sha: String!
  "Its directories and submodules first, then its files and symlinks, each by name."
  entries: [TreeEntry!]!
  "Its README, when it holds one: the first, whatever its case, of README.md, README.markdown, README.mdown, README.mkd, README.mkdn, README.txt and README, unless it is binary; Markdown comes rendered."
  readme: File
}

"Which parents of each commit a history follows."
enum HistoryParents {
  "The first alone: a branch's line of merges."
  FIRST
  "Every one: a merge's other lines too."
  ALL
}

"What a tree's entry is: a directory, a file, a symlink, or a submodule, which pins a commit of another repository."
enum EntryKind {
  TREE
  BLOB
  SYMLINK
  SUBMODULE
}

"One of a directory's entries."
type TreeEntry {
  name: String!
  "Its path from the repository's root."
  path: String!
  kind: EntryKind!
  "Its mode as Git writes it, such as 100644, 100755 or 040000."
  mode: String!
  "The object it names; a submodule's is the commit it pins."
  sha: String!
  "A file's or a symlink's size in bytes; null for a directory or a submodule."
  size: Int
}

"A file or a symlink at a commit, and its text when it isn't binary."
type File {
  "The commit the ref resolved to."
  commit: String!
  "Its path from the repository's root."
  path: String!
  name: String!
  "BLOB or SYMLINK."
  kind: EntryKind!
  "Its mode as Git writes it, such as 100644 or 120000."
  mode: String!
  "Its blob's object."
  sha: String!
  "Its size in bytes."
  size: Int!
  "Whether it is binary, as Git judges a file (a NUL in its first 8000 bytes), or not UTF-8."
  binary: Boolean!
  "Whether its text stops at 1 MiB, short of its size."
  truncated: Boolean!
  "Its text, up to 1 MiB; null when it is binary. A symlink's is its target."
  text: String
  "A Markdown file's text rendered as GitHub-flavoured Markdown, sanitized: no scripts, styles, frames, forms or event handlers. Its relative links open the Console's pages at the same ref, its relative images load the REST API's raw bytes at the commit, images from elsewhere stay at their URLs for the browser to load, and its ids start with user-content-. Null for any other file."
  html: String
}

"A change from one commit to another, up to the limits of a diff: at most 3000 files, 20000 lines of hunks in all, 5000 in one file and 64 KiB in one line. Past them it lists what it left out rather than show it."
type Diff {
  "The commit it runs from: a commit's first parent, or a branch's merge base with its base's tip. Null when it runs from the empty tree, for a root commit or a branch that shares no history with its base."
  base: String
  "A branch's base's tip, which its merge base is reckoned from; null for a commit."
  baseTip: String
  "The commit it runs to."
  head: String!
  "The files it changes, in Git's order, by path."
  files: [FileDiff!]!
  "How many files it changes past the 3000 it lists."
  filesLeftOut: Int!
  "The lines it adds, in every file it changes, those it left out included."
  additions: Int!
  "The lines it removes, in every file it changes, those it left out included."
  deletions: Int!
}

"What a change did to a file."
enum FileStatus {
  ADDED
  MODIFIED
  DELETED
  RENAMED
  "A path whose kind changed, such as a symlink that became a file."
  TYPE_CHANGED
}

"One file's change."
type FileDiff {
  status: FileStatus!
  "Its path from the repository's root; a deleted file's old one."
  path: String!
  "The path it had before, for a renamed file; null otherwise."
  oldPath: String
  "Its mode before, as Git writes it; null for an added file."
  oldMode: String
  "Its mode after; null for a deleted file."
  mode: String
  "Whether Git reads it as binary, which shows no lines."
  binary: Boolean!
  additions: Int!
  deletions: Int!
  "Whether its hunks were left out: it passes 5000 lines or holds a line past 64 KiB, or the diff passed 20000 lines before it. Its counts stay."
  truncated: Boolean!
  hunks: [Hunk!]!
}

"One run of a file's changes, with up to three lines around them."
type Hunk {
  "Its first line in the old file, or the line before it when it spans none."
  oldStart: Int!
  oldLines: Int!
  "Its first line in the new file, or the line before it when it spans none."
  newStart: Int!
  newLines: Int!
  "The heading Git found above it, such as a function's; empty when it found none."
  section: String!
  lines: [DiffLine!]!
}

"What a hunk's line is."
enum LineKind {
  CONTEXT
  ADDED
  REMOVED
}

"One of a hunk's lines, without its newline."
type DiffLine {
  kind: LineKind!
  "Its number in the old file; null for an added line."
  old: Int
  "Its number in the new file; null for a removed line."
  new: Int
  text: String!
  "Whether the file ends on it without a newline."
  noNewline: Boolean!
}

extend type Mutation {
  "Sets an annotation on one of the repository's commits for the viewer, or changes the one the viewer set there before, and answers it as it now is; takes annotations.write. An annotation of that name that another principal set is refused (CONFLICT, annotation.taken), naming them, until it is deleted. With expectedVersion, an annotation at another version, or none, is refused (CONFLICT, precondition.failed)."
  setAnnotation(repositoryId: ID!, sha: String!, name: String!, input: AnnotationInput!, expectedVersion: Int): Annotation!
  "Deletes an annotation from one of the repository's commits, which frees its name there, and answers true; takes annotations.write for the viewer's own, and annotations.delete_any for another principal's. With expectedVersion, an annotation at another version, or none, is refused (CONFLICT, precondition.failed)."
  deleteAnnotation(repositoryId: ID!, sha: String!, name: String!, expectedVersion: Int): Boolean!
  "Merges one of the repository's branches into its base, main, for the viewer, and answers once Cobranch has recorded the merge as a push of main, which makes the branch MERGED once the push worker processes it; takes repo.merge for a READY branch, and repo.bypass for one that isn't, which also passes main's merge requirements. A head the branch has moved from, or a branch or a main that moved while Cobranch built the merge, is refused (CONFLICT, branch.moved); so are a branch with nothing to merge, one that isn't READY, a fast-forward of one behind main, a merge commit of one that conflicts with main and a push the merge requirements refuse, each with a reason of its own. It builds the merge on the Git server: an installation without one answers UNAVAILABLE."
  mergeBranch(repositoryId: ID!, branch: String!, input: MergeInput): MergeResult!
  "Submits the viewer's review of one of the repository's commits, which works out again the status of the branches at it, and answers it; takes reviews.submit. A review is never changed: its reviewer submits another, and their latest is the one that counts."
  submitReview(repositoryId: ID!, sha: String!, input: ReviewInput!): Review!
}

"The review a principal submits."
input ReviewInput {
  state: ReviewState!
  "What the reviewer writes, at most 65,536 characters, which only an approval may leave blank."
  body: String! = ""
}

"A review's verdict on a commit."
enum ReviewState {
  "Approves it: a person's approval counts towards a branch's required approvals."
  APPROVED
  "Asks for changes, which holds back a branch whose base requires reviews until its reviewer submits another."
  CHANGES_REQUESTED
  "Comments without a verdict, and takes back its reviewer's earlier one."
  NEUTRAL
}

"A principal's verdict on a commit, with what they wrote. It belongs to the commit, so every branch at that commit shows it, and it is never changed."
type Review {
  id: ID!
  "The commit reviewed."
  sha: String!
  state: ReviewState!
  body: String!
  "Who submitted it; null once they are gone, when it counts no more."
  reviewer: CommitPrincipal
  "Whether its reviewer is a person, whose approvals count towards a branch's required approvals; agents' and API keys' don't."
  person: Boolean!
  submittedAt: Time!
}

"How to merge a branch into its base."
input MergeInput {
  "The head the requester saw; the merge is refused once the branch moved from it."
  head: String
  "How the merge moves its base; left out, FAST_FORWARD where the base requires linear history, which allows only that, and MERGE otherwise."
  method: MergeMethod
}

"How a merge moves its base."
enum MergeMethod {
  "A merge commit, Merge branch '<name>', authored and committed by the requester."
  MERGE
  "A fast-forward, which writes nothing."
  FAST_FORWARD
}

"A merge Cobranch recorded as a push of its base."
type MergeResult {
  "The branch merged into, main."
  base: String!
  "The head merged."
  head: String!
  "The commit the base is at now, the merge commit or, for a fast-forward, the head."
  commit: String!
}

"One of a repository's live branches and the commit it is at."
type Branch {
  "Its name, without refs/heads/."
  name: String!
  "The object it is at."
  head: String!
  "The commit it is at; null while its head is no commit a push recorded."
  commit: Commit
  createdAt: Time!
  "When a push last moved it."
  updatedAt: Time!
  "The branch it merges into, main; null for main."
  base: String
  "Where it stands as a request to merge into its base; null for main."
  status: BranchStatus
  "How it meets its base's merge requirements, as its status last worked them out: each required annotation, linear history and reviews when required, and being up to date. Empty for main."
  checks: [BranchCheck!]!
  "How many commits it has that its base lacks; null for main, and until a push works it out."
  ahead: Int
  "How many commits its base has that it lacks; null for main, and until a push works it out."
  behind: Int
  "What a merge into it needs, as main's /cobranch.yaml names it under branches; null when it names no such branch."
  requirements: MergeRequirements
  "The last merge recorded of it into its base; null when none was. It is MERGED while its head is the merge's."
  merge: BranchMerge
}

"A merge of a branch into its base that a push made."
type BranchMerge {
  "The head it brought into the base."
  head: String!
  "Who pushed it; null once they are gone."
  by: CommitPrincipal
  "When Cobranch recorded the push."
  at: Time!
}

"Where a branch stands as a request to merge into its base, the first that holds."
enum BranchStatus {
  "The push worker hasn't worked out its last push, or a required annotation on its head is pending or in progress."
  PROCESSING
  "It has commits to merge, and a requirement holds them back."
  BLOCKED
  "It has nothing to merge, and no merge took its head into its base."
  EMPTY
  "A merge took its head into its base."
  MERGED
  "It has commits to merge, and nothing holds them back."
  READY
}

"What one of a branch's checks is of."
enum BranchCheckKind {
  "An annotation its head must carry, Successful."
  ANNOTATION
  "No merge among its commits to merge."
  LINEAR_HISTORY
  "People's approvals of its head, besides its author's and its pusher's."
  APPROVALS
  "A reviewer whose latest review of its head requests changes; never met."
  CHANGES_REQUESTED
  "Its base's tip in it."
  UP_TO_DATE
}

"One of a branch's merge requirements and how it stands."
type BranchCheck {
  kind: BranchCheckKind!
  "The required annotation's name, for ANNOTATION; the reviewer's display name, for CHANGES_REQUESTED; null otherwise."
  name: String
  "The required annotation's status on the head; null while it carries none, and unless kind is ANNOTATION."
  status: AnnotationStatus
  "For LINEAR_HISTORY, the merges among its commits to merge; for APPROVALS, the approvals that count; for UP_TO_DATE, the commits of its base it lacks; null otherwise."
  count: Int
  "For APPROVALS, how many the base requires; null otherwise."
  required: Int
  met: Boolean!
}

"What a merge into a branch needs, as main's /cobranch.yaml names it under branches."
type MergeRequirements {
  "The annotations the incoming head must carry, Successful."
  annotations: [String!]!
  "Whether no merge commit may come in."
  linearHistory: Boolean!
  "The reviews a merge needs of the incoming head; null when it requires none."
  reviews: ReviewRequirements
}

"The reviews a merge needs of the incoming head: no reviewer's latest review requesting changes, and at least approvals people's latest reviews approving it, besides its author's and its pusher's."
type ReviewRequirements {
  "0 to 10."
  approvals: Int!
}

"A page of history, nearest first."
type CommitPage {
  commits: [Commit!]!
  "Where the next page starts, as history's after; null after the last page."
  nextCursor: String
}

"A commit a push brought, as the push recorded it."
type Commit {
  sha: String!
  tree: String!
  "Its parents' names, in Git's order: history follows all of them, or the first alone, as asked."
  parents: [String!]!
  message: String!
  author: Person!
  committer: Person!
  "Its signature as written, not checked yet; empty for an unsigned commit."
  signature: String!
  "The annotations principals set on it, by name."
  annotations: [Annotation!]!
  "The reviews submitted of it, in the order they were; each reviewer's latest is the one that counts."
  reviews: [Review!]!
  "The push that first brought it; Repository.commit alone answers it, and null elsewhere."
  push: Push
}

"A principal's verdict on a commit, such as ci/build passing. It belongs to the commit, so every branch at that commit shows it; a commit holds at most one of each name, which only its principal changes."
type Annotation {
  id: ID!
  "1 to 100 lowercase letters, digits, '-', '_', '.' and '/', starting with a letter or digit, such as ci/build."
  name: String!
  status: AnnotationStatus!
  summary: String!
  "Where its details are; empty without one."
  link: String!
  "Who set it; null once they are gone."
  principal: CommitPrincipal
  createdAt: Time!
  updatedAt: Time!
  "When its run started: when it was set, or when it last went back from FAILED or SUCCESSFUL to PENDING or IN_PROGRESS."
  startedAt: Time!
  "When it reached FAILED or SUCCESSFUL; null while it runs."
  completedAt: Time
  "Counts its changes from 1: a change names it as expectedVersion to refuse one made meanwhile."
  version: Int!
}

"Where an annotation stands, in any order its principal sets them."
enum AnnotationStatus {
  PENDING
  IN_PROGRESS
  FAILED
  SUCCESSFUL
}

"What a principal sets an annotation to."
input AnnotationInput {
  status: AnnotationStatus!
  "At most 500 characters."
  summary: String! = ""
  "Where its details are, an absolute http or https URL of at most 2048 bytes; none when empty."
  link: String! = ""
}

"A commit's author or committer as the commit writes them."
type Person {
  name: String!
  email: String!
  at: Time!
  "The zone the commit wrote its time in, such as +0200."
  zone: String!
  "Who is behind them; null until the push worker maps their email."
  principal: CommitPrincipal
}

"Who is behind a commit's author or committer, a push, an annotation or a merge: a user, perhaps one with no login whom a push made for an unknown email, or an API key."
type CommitPrincipal {
  id: ID!
  displayName: String!
}

"The push that first brought a commit."
type Push {
  id: ID!
  "Who pushed; null once they are gone."
  pusher: CommitPrincipal
  "https or ssh, or api for a merge asked of Cobranch."
  transport: String!
  "When Cobranch recorded it."
  at: Time!
}
