# Repositories: an organization's Git repositories, their settings and the grants that reach them
# (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/git-hosting.md, "Repositories").

"Who reaches a repository, as its grants say: nobody sets it."
enum RepositoryVisibility {
  "Its creator and the organization's Owners alone."
  PRIVATE
  "Someone else too, through a grant on it or a role at the organization."
  INTERNAL
}

extend type Organization {
  "The repositories the viewer reads, by slug; takes org.read."
  repositories: [Repository!]!
  "A repository by its slug, current or former: null unless the viewer reads it."
  repository(slug: String!): Repository
}

extend type Mutation {
  "Creates an empty repository in the organization, with the viewer its Maintainer, and answers it with the visibility its grants give it (Internal at once where an organization role reads every repository); takes repos.create. An organization that holds as many repositories as its limit allows is refused (CONFLICT, limit.repositories)."
  createRepository(organizationId: ID!, input: RepositoryInput!): Repository!
  "Changes a repository's slug, name and description; takes repo.manage. A new slug keeps the old one as a redirect."
  updateRepository(id: ID!, input: RepositoryInput!): Repository!
  "Gives one of the organization's members or API keys a role on the repository, or one of its jobs Secret reader; takes org.grants.manage and every permission the role gives there."
  grantRepositoryRole(repositoryId: ID!, principalId: ID!, roleId: ID!): Boolean!
  "Takes a role from a principal on the repository; takes org.grants.manage and every permission the role gives there."
  revokeRepositoryRole(repositoryId: ID!, principalId: ID!, roleId: ID!): Boolean!
}

"One of an organization's Git repositories: a slug for its URLs, unique in the organization, a name and a description. Every repository opens on main, its default branch, which nobody changes."
type Repository {
  id: ID!
  organizationId: ID!
  "The current slug; a lookup by an old one finds the repository with this one."
  slug: String!
  name: String!
  description: String!
  "The hash its history's objects are named by: sha1, or sha256 later."
  objectFormat: String!
  visibility: RepositoryVisibility!
  "Who created it; null once they are gone."
  createdBy: ID
  createdAt: Time!
  "The permissions the viewer holds on the repository."
  viewerPermissions: [String!]!
  "Who holds roles on the repository, by display name, with each role, how it reaches the repository and since when; takes repo.read. A role at the organization counts when it gives a repository permission."
  access: [RepositoryAccess!]!
  "The roles the repository grants, each with the permissions it gives there; takes repo.read."
  roles: [Role!]!
  "The repository summed up, as Organization.repositories lists it; null elsewhere."
  summary: RepositorySummary
}

"A repository summed up for its organization's list, which alone answers it."
type RepositorySummary {
  "Its live branches but main and those merged already."
  openBranches: Int!
  "Those of its open branches that are Ready."
  readyBranches: Int!
  "When its last push was recorded; null before its first."
  lastPushAt: Time
  main: MainStatus!
}

"How a repository's main stands by the annotations on its head."
enum MainStatus {
  "No annotations on its head, or no main yet."
  NONE
  "An annotation pending or in progress, and none failed."
  RUNNING
  "An annotation failed."
  FAILING
  "Every annotation succeeded."
  PASSING
}

"A principal's roles on a repository."
type RepositoryAccess {
  principalId: ID!
  "user, api_key, job or agent."
  kind: String!
  displayName: String!
  "The roles it holds on the repository itself, each with the permissions it gives there; none for a principal the organization's roles alone reach."
  roles: [Role!]!
  "Every role that reaches the repository, how and since when; its grants on the repository first, then its roles at the organization."
  grants: [RepositoryGrant!]!
}

"A role that reaches a repository, with the permissions it gives there."
type RepositoryGrant {
  role: Role!
  "repository for a grant on the repository itself, organization for a role at its organization, which reaches every repository of it."
  through: String!
  "When the role was granted."
  since: Time!
}

"What makes or changes a repository. updateRepository takes every field as the repository's new value."
input RepositoryInput {
  "1 to 100 lowercase letters, digits, hyphens, dots and underscores, starting with a letter or digit, not ending in .git, unique in the organization."
  slug: String!
  "The slug when null or empty."
  name: String
  description: String
}
