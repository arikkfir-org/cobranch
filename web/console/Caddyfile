# The Console's server: its static files on port 8080, /healthz for the kubelet, and /config.json, which tells its
# pages where the REST API answers: DEVHUB_REST_URL, or, when empty, the root of their own host. The operator's routes bring the
# domain and TLS.
{
	admin off
	auto_https off
	persist_config off
	log {
		format json
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle /config.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `\{"restUrl":"{env.DEVHUB_REST_URL}"\}` 200
	}
	handle {
		root * /srv
		# The Console routes in the browser: every path it doesn't have a file for gets its page.
		try_files {path} /index.html
		file_server
	}
}
